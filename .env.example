# Copy this file to .env and fill in real values before running the app.
# DO NOT commit .env — it is gitignored.

# ── Core LLMs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Groq (voice STT via Whisper-large-v3)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=3

# ── Email / Notifications ──────────────────────────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
BREVO_API_KEY=your_brevo_api_key
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
ADVISOR_EMAIL=advisor@example.com
ADVISOR_NAME=Financial Advisor

# ── Speech — TTS (Sarvam AI primary, gTTS fallback) ───────────────────────────
SARVAM_API_KEY=your_sarvam_api_key
TTS_SARVAM_SPEAKER_EN=anushka
TTS_SARVAM_SPEAKER_HI=manisha
TTS_VOICE_NAME=en-IN-Neural2-A
TTS_CACHE_DIR=data/tts_cache
TTS_CACHE_TTL_DAYS=7
TTS_PACE=1.0

# ── Speech — STT (Deepgram fallback) ──────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
STT_CONFIDENCE_THRESHOLD=0.7
STT_SILENCE_TIMEOUT_SECONDS=3

# ── Google Cloud (Calendar / Sheets / Docs / STT) ─────────────────────────────
# Option 1: path to service account JSON file (local dev)
GOOGLE_SERVICE_ACCOUNT_PATH=config/service_account.json
# Option 2: full JSON as a single-line string (cloud/Docker — takes precedence)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
CALENDAR_SLOT_DURATION_MINUTES=30
CALENDAR_HOLD_EXPIRY_HOURS=48
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB_NAME=Advisor Pre-Bookings
GOOGLE_DOC_ID=your_google_doc_id

# ── Security ──────────────────────────────────────────────────────────────────
SECURE_URL_SECRET=generate_a_random_hex_64_char_string
SECURE_URL_DOMAIN=http://localhost:8501
SECURE_URL_TTL_SECONDS=86400
SECURE_BASE_URL=http://localhost:8501

# ── Vector DB (ChromaDB) ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=advisor_faq
RAG_TOP_K=3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Booking Logic ─────────────────────────────────────────────────────────────
MOCK_CALENDAR_PATH=data/mock_calendar.json
ADVISOR_ID=ADV-001
MAX_REPROMPTS=3
MAX_TURNS_PER_CALL=20

# ── Application ───────────────────────────────────────────────────────────────
MCP_MODE=mock                         # mock | live
MCP_SERVER_URL=http://localhost:3000
PRODUCT_NAME=INDMoney Advisor Suite
ROUTER_MODE=keyword
ENVIRONMENT=development
SESSION_TTL_SECONDS=1800
LOG_LEVEL=INFO
VOICE_AUDIT_LOG_PATH=data/logs/voice_audit_log.jsonl
MCP_OPS_LOG_PATH=data/logs/mcp_ops_log.jsonl
LOG_TO_STDOUT=true
